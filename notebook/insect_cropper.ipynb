    "def yolo_to_pixels(xc, yc, w, h, img_w, img_h):\n",
    "    \"\"\"\n",
    "    Convert YOLO normalized bbox to pixel coordinates (x_min, y_min, x_max, y_max)\n",
    "    \"\"\"\n",
    "    x_min = int((xc - w/2) * img_w)\n",
    "    y_min = int((yc - h/2) * img_h)\n",
    "    x_max = int((xc + w/2) * img_w)\n",
    "    y_max = int((yc + h/2) * img_h)\n",
    "    \n",
    "    # clamp\n",
    "    x_min = max(x_min, 0)\n",
    "    y_min = max(y_min, 0)\n",
    "    x_max = min(x_max, img_w - 1)\n",
    "    y_max = min(y_max, img_h - 1)\n",
    "    \n",
    "    return [x_min, y_min, x_max, y_max]\n",
