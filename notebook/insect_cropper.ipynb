   "source": [
    "## removing insects with rank 11077, 11431, 7541\n",
    "\n",
    "\"\"\"\n",
    "Estimate a background color (BGR) from a thin ring around the crop.\n",
    "If the crop touches image border so ring is empty, fall back to image mean color.\n",
    "\"\"\"\n",
    "def get_background_color(img, x1, y1, x2, y2, sample_border=5):\n",
    "    h, w = img.shape[:2]\n",
    "    # ring bounds (clamp)\n",
    "    bx1 = max(0, x1 - sample_border)\n",
    "    by1 = max(0, y1 - sample_border)\n",
    "    bx2 = min(w, x2 + sample_border)\n",
    "    by2 = min(h, y2 + sample_border)\n",
    "\n",
    "    # Create mask for ring region: outer rect minus inner rect\n",
    "    outer = img[by1:by2, bx1:bx2]\n",
    "    inner_x1 = x1 - bx1\n",
    "    inner_y1 = y1 - by1\n",
    "    inner_x2 = inner_x1 + (x2 - x1)\n",
    "    inner_y2 = inner_y1 + (y2 - y1)\n",
    "\n",
    "    # If inner rect is invalid (crop covers whole outer), fallback\n",
    "    if outer.size == 0 or inner_x1 <= 0 or inner_y1 <= 0 or inner_x2 >= outer.shape[1] or inner_y2 >= outer.shape[0]:\n",
    "        # fallback to whole-image mean color\n",
    "        mean_color = cv2.mean(img)[:3]\n",
    "        return tuple(int(c) for c in mean_color[::-1])  # cv2 uses BGR, return BGR ints\n",
    "\n",
    "    # Build mask for ring\n",
    "    mask = 255 * np.ones((outer.shape[0], outer.shape[1]), dtype=np.uint8)\n",
    "    mask[inner_y1:inner_y2, inner_x1:inner_x2] = 0\n",
    "    # compute mean color over masked area\n",
    "    mean_b = cv2.mean(outer[:, :, 0], mask=mask)[0]\n",
    "    mean_g = cv2.mean(outer[:, :, 1], mask=mask)[0]\n",
    "    mean_r = cv2.mean(outer[:, :, 2], mask=mask)[0]\n",
    "    return (int(mean_b), int(mean_g), int(mean_r))\n",
    "\n",
    "\n",
    "\"\"\"\n",
    "Remove lines that start with class_id_to_remove from all YOLO .txt files in labels_path,\n",
    "paint over the corresponding boxes in the matching images by filling with estimated background color,\n",
    "and save back the cleaned label files and images.\n",
    "\n",
    "class_id_to_remove: int or str class id to remove (e.g. 11077)\n",
    "images_path: path to images directory\n",
    "labels_path: path to label files directory\n",
    "image_extensions: which image file extensions to look for\n",
    "sample_border: border size used by get_background_color\n",
    "make_backup: if True, a backup of the original image will be kept with suffix .bak\n",
    "\"\"\"\n",
    "def remove_class_from_labels_and_paint(\n",
    "    class_id_to_remove,\n",
    "    images_path: str,\n",
    "    labels_path: str,\n",
    "    image_extensions: List[str] = [\".jpg\", \".jpeg\", \".png\"],\n",
    "    sample_border: int = 5,\n",
    "    make_backup: bool = False\n",
    "):\n",
    "    class_id_to_remove = str(class_id_to_remove)\n",
    "    files_modified = 0\n",
    "    boxes_removed_total = 0\n",
    "\n",
    "    for filename in sorted(os.listdir(labels_path)):\n",
    "        if not filename.endswith(\".txt\"):\n",
    "            continue\n",
    "\n",
    "        label_path = os.path.join(labels_path, filename)\n",
    "        base = os.path.splitext(filename)[0]\n",
    "\n",
    "        # find image file\n",
    "        img_path = None\n",
    "        for ext in image_extensions:\n",
    "            candidate = os.path.join(images_path, base + ext)\n",
    "            if os.path.exists(candidate):\n",
    "                img_path = candidate\n",
    "                break\n",
    "\n",
    "        # If no corresponding image, skip\n",
    "        if img_path is None:\n",
    "            # optionally print a warning or continue silently\n",
    "            # print(f\"Warning: no image found for {filename}\")\n",
    "            continue\n",
    "\n",
    "        # read labels\n",
    "        with open(label_path, \"r\") as f:\n",
    "            lines = f.readlines()\n",
    "\n",
    "        if not lines:\n",
    "            # nothing in file\n",
    "            continue\n",
    "\n",
    "        remaining_lines = []\n",
    "        removed_boxes = []\n",
    "\n",
    "        for line in lines:\n",
    "            parts = line.strip().split()\n",
    "            if len(parts) < 5:\n",
    "                # keep malformed or unexpected lines as-is (or skip)\n",
    "                remaining_lines.append(line)\n",
    "                continue\n",
    "            cls = parts[0]\n",
    "            if cls == class_id_to_remove:\n",
    "                try:\n",
    "                    xc, yc, bw, bh = map(float, parts[1:5])\n",
    "                    removed_boxes.append((xc, yc, bw, bh))\n",
    "                except Exception:\n",
    "                    # malformed numbers -> skip removal to be safe\n",
    "                    continue\n",
    "            else:\n",
    "                remaining_lines.append(line)\n",
    "\n",
    "        # if nothing removed, skip image editing and label rewrite\n",
    "        if not removed_boxes:\n",
    "            continue\n",
    "\n",
    "        # load image\n",
    "        img = cv2.imread(img_path)\n",
    "        if img is None:\n",
    "            # couldn't read image for some reason\n",
    "            continue\n",
    "        img_h, img_w = img.shape[:2]\n",
    "\n",
    "        # optionally make backup\n",
    "        if make_backup:\n",
    "            backup_path = img_path + \".bak\"\n",
    "            if not os.path.exists(backup_path):\n",
    "                cv2.imwrite(backup_path, img)\n",
    "\n",
    "        boxes_removed_in_file = 0\n",
    "\n",
    "        for (xc, yc, bw, bh) in removed_boxes:\n",
    "            # convert to pixels (float), then clamp and int\n",
    "            x1f, y1f, x2f, y2f = yolo_to_pixels(xc, yc, bw, bh, img_w, img_h)\n",
    "\n",
    "            # clamp to image boundaries\n",
    "            x1 = int(clamp(x1f, 0, img_w - 1))\n",
    "            y1 = int(clamp(y1f, 0, img_h - 1))\n",
    "            x2 = int(clamp(x2f, 0, img_w - 1))\n",
    "            y2 = int(clamp(y2f, 0, img_h - 1))\n",
    "\n",
    "            # validate area\n",
    "            if box_area(x1, y1, x2, y2) <= 0:\n",
    "                continue\n",
    "\n",
    "            # estimate background color and fill\n",
    "            color = get_background_color(img, x1, y1, x2, y2, sample_border=sample_border)\n",
    "            # fill rectangle with color (BGR)\n",
    "            cv2.rectangle(img, (x1, y1), (x2, y2), color, thickness=-1)\n",
    "\n",
    "            boxes_removed_in_file += 1\n",
    "\n",
    "        # Save updated image (overwrite)\n",
    "        cv2.imwrite(img_path, img)\n",
    "\n",
    "        # Overwrite label file with remaining lines\n",
    "        with open(label_path, \"w\") as f:\n",
    "            f.writelines(remaining_lines)\n",
    "\n",
    "        files_modified += 1\n",
    "        boxes_removed_total += boxes_removed_in_file\n",
    "\n",
    "    print(f\"Done. Painted and removed class {class_id_to_remove} in {files_modified} files; total boxes removed: {boxes_removed_total}.\")\n",
    "\n",
    "\n",
    "unwanted_class_ids = [11077, 11431, 7541, 7243]\n",
    "\n",
    "for class_id in unwanted_class_ids:\n",
    "    remove_class_from_labels_and_paint(class_id, images_path, labels_path)\n",
    "\n",
    "print(\"Done\")"
   ]
  },
