    "import os\n",
    "import cv2\n",
    "import random\n",
    "import numpy as np\n",
    "from pathlib import Path\n",
    "from collections import Counter, defaultdict\n",
    "\n",
    "############################################\n",
    "# CONFIG\n",
    "############################################\n",
    "RANDOM_SEED = 42\n",
    "TARGET_COUNT = 330\n",
    "MAX_OVERSHOOT = 50   \n",
    "\n",
    "random.seed(RANDOM_SEED)\n",
    "np.random.seed(RANDOM_SEED)\n",
    "\n",
    "############################################\n",
    "# YOLO IO\n",
    "############################################\n",
    "def read_yolo_labels(path):\n",
    "    labels = []\n",
    "    with open(path) as f:\n",
    "        for line in f:\n",
    "            p = line.strip().split()\n",
    "            if len(p) == 5:\n",
    "                labels.append((p[0], *map(float, p[1:])))\n",
    "    return labels\n",
    "\n",
    "def write_yolo_labels(path, labels):\n",
    "    with open(path, \"w\") as f:\n",
    "        for c, x, y, w, h in labels:\n",
    "            f.write(f\"{c} {x} {y} {w} {h}\\n\")\n",
    "\n",
    "############################################\n",
    "# SIMPLE AUGMENTATION\n",
    "############################################\n",
    "def try_augment_image_and_labels(img, labels):\n",
    "    h, w = img.shape[:2]\n",
    "\n",
    "    # random horizontal flip\n",
    "    if random.random() < 0.5:\n",
    "        img = cv2.flip(img, 1)\n",
    "        labels = [(c, 1-x, y, bw, bh) for c,x,y,bw,bh in labels]\n",
    "\n",
    "    # small brightness change\n",
    "    alpha = 0.8 + random.random()*0.4\n",
    "    img = np.clip(img * alpha, 0, 255).astype(np.uint8)\n",
    "\n",
    "    return img, labels\n",
    "\n",
    "############################################\n",
    "# PHASE 1 — HARD DOWNSAMPLE\n",
    "############################################\n",
    "def hard_downsample_to_cap(labels_dir, cap):\n",
    "    class_instances = defaultdict(list)\n",
    "    file_lines = {}\n",
    "\n",
    "    for f in os.listdir(labels_dir):\n",
    "        if not f.endswith(\".txt\"):\n",
    "            continue\n",
    "        path = os.path.join(labels_dir, f)\n",
    "        lines = open(path).readlines()\n",
    "        file_lines[f] = lines\n",
    "        for i,l in enumerate(lines):\n",
    "            p = l.split()\n",
    "            if p:\n",
    "                class_instances[p[0]].append((f,i))\n",
    "\n",
    "    keep = defaultdict(set)\n",
    "    for cls, insts in class_instances.items():\n",
    "        if len(insts) <= cap:\n",
    "            for f,i in insts:\n",
    "                keep[f].add(i)\n",
    "        else:\n",
    "            for f,i in random.sample(insts, cap):\n",
    "                keep[f].add(i)\n",
    "\n",
    "    for f, lines in file_lines.items():\n",
    "        new = [l for i,l in enumerate(lines) if i in keep[f]]\n",
    "        with open(os.path.join(labels_dir,f),\"w\") as out:\n",
    "            out.writelines(new)\n",
    "\n",
    "    print(f\" Hard downsample done (cap={cap})\")\n",
    "\n",
    "############################################\n",
    "# COUNT INSTANCES\n",
    "############################################\n",
    "def compute_class_counts(labels_dir):\n",
    "    c = Counter()\n",
    "    for f in os.listdir(labels_dir):\n",
    "        if f.endswith(\".txt\"):\n",
    "            for l in open(os.path.join(labels_dir,f)):\n",
    "                p = l.split()\n",
    "                if p:\n",
    "                    c[p[0]] += 1\n",
    "    return c\n",
    "\n",
    "############################################\n",
    "# BUILD AUGMENT CANDIDATES\n",
    "############################################\n",
    "def build_candidates(images_dir, labels_dir):\n",
    "    cands = []\n",
    "    for img_name in os.listdir(images_dir):\n",
    "        if not img_name.lower().endswith((\".jpg\",\".png\",\".jpeg\")):\n",
    "            continue\n",
    "        base = Path(img_name).stem\n",
    "        lbl = os.path.join(labels_dir, base+\".txt\")\n",
    "        if not os.path.exists(lbl):\n",
    "            continue\n",
    "        labels = read_yolo_labels(lbl)\n",
    "        if labels:\n",
    "            cands.append((img_name, labels))\n",
    "    return cands\n",
    "\n",
    "############################################\n",
    "# PHASE 2 — AUGMENT (SOFT TARGET)\n",
    "############################################\n",
    "def augment_until_target(img_dir, lbl_dir, out_img_dir, out_lbl_dir):\n",
    "    os.makedirs(out_img_dir, exist_ok=True)\n",
    "    os.makedirs(out_lbl_dir, exist_ok=True)\n",
    "\n",
    "    counts = compute_class_counts(lbl_dir)\n",
    "    candidates = build_candidates(img_dir, lbl_dir)\n",
    "\n",
    "    aug_i = 0\n",
    "    random.shuffle(candidates)\n",
    "\n",
    "    while True:\n",
    "        done = True\n",
    "        for cls in counts:\n",
    "            if counts[cls] < TARGET_COUNT:\n",
    "                done = False\n",
    "                break\n",
    "        if done:\n",
    "            break\n",
    "\n",
    "        img_name, labels = random.choice(candidates)\n",
    "        img = cv2.imread(os.path.join(img_dir, img_name))\n",
    "        if img is None:\n",
    "            continue\n",
    "\n",
    "        aug_img, aug_lbls = try_augment_image_and_labels(img, labels)\n",
    "        add = Counter([c for c,_,_,_,_ in aug_lbls])\n",
    "\n",
    "        # allow soft overshoot\n",
    "        if any(counts[c] + add[c] > TARGET_COUNT + MAX_OVERSHOOT for c in add):\n",
    "            continue\n",
    "\n",
    "        base = Path(img_name).stem\n",
    "        cv2.imwrite(os.path.join(out_img_dir,f\"{base}_aug{aug_i}.jpg\"), aug_img)\n",
    "        write_yolo_labels(os.path.join(out_lbl_dir,f\"{base}_aug{aug_i}.txt\"), aug_lbls)\n",
    "\n",
    "        for c,n in add.items():\n",
    "            counts[c] += n\n",
    "\n",
    "        aug_i += 1\n",
    "\n",
    "    print(\" Augmentation finished\")\n",
    "    return counts\n",
    "\n",
    "############################################\n",
    "# FINAL REPORT\n",
    "############################################\n",
    "def final_report(label_dirs):\n",
    "    total = Counter()\n",
    "    for d in label_dirs:\n",
    "        total += compute_class_counts(d)\n",
    "\n",
    "    print(\"\\n FINAL DATASET\")\n",
    "    print(\"-\"*50)\n",
    "    for c in sorted(total):\n",
    "        print(f\"Class {c}: {total[c]}\")\n",
    "    print(\"-\"*50)\n",
    "\n",
    "############################################\n",
    "# RUN PIPELINE\n",
    "############################################\n",
    "hard_downsample_to_cap(crop_labels_path, TARGET_COUNT)\n",
    "\n",
    "augment_until_target(\n",
    "    crop_images_path,\n",
    "    crop_labels_path,\n",
    "    aug_images_path,\n",
    "    aug_labels_path\n",
    ")\n",
    "\n",
    "final_report([crop_labels_path, aug_labels_path])\n"
   ]
  },
