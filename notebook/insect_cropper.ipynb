    "from skmultilearn.model_selection import iterative_train_test_split\n",
    "\n",
    "# ---------------------------\n",
    "# CONFIG\n",
    "# ---------------------------\n",
    "RANDOM_SEED = 42\n",
    "random.seed(RANDOM_SEED)\n",
    "np.random.seed(RANDOM_SEED)\n",
    "\n",
    "dataset_dir = \"../dataset/final_dataset\"  # of \"aug_dataset\"\n",
    "images_dir = os.path.join(dataset_dir, \"images\")\n",
    "labels_dir = os.path.join(dataset_dir, \"labels\")\n",
    "\n",
    "output_dir = \"../dataset/dataset_splits\"\n",
    "train_dir = os.path.join(output_dir, \"train\")\n",
    "val_dir   = os.path.join(output_dir, \"val\")\n",
    "test_dir  = os.path.join(output_dir, \"test\")\n",
    "\n",
    "train_frac = 0.8\n",
    "val_frac   = 0.1\n",
    "test_frac  = 0.1\n",
    "\n",
    "os.makedirs(train_dir, exist_ok=True)\n",
    "os.makedirs(val_dir, exist_ok=True)\n",
    "os.makedirs(test_dir, exist_ok=True)\n",
    "\n",
    "for d in [\"images\", \"labels\"]:\n",
    "    os.makedirs(os.path.join(train_dir, d), exist_ok=True)\n",
    "    os.makedirs(os.path.join(val_dir, d), exist_ok=True)\n",
    "    os.makedirs(os.path.join(test_dir, d), exist_ok=True)\n",
    "\n",
    "# ---------------------------\n",
    "# READ LABELS AND BUILD MULTI-LABEL MATRIX\n",
    "# ---------------------------\n",
    "image_files = [f for f in os.listdir(images_dir) if f.lower().endswith((\".jpg\", \".png\", \".jpeg\"))]\n",
    "image_files.sort()\n",
    "\n",
    "# Map class names to indices\n",
    "all_classes = set()\n",
    "image_labels = []\n",
    "for img_name in image_files:\n",
    "    base = Path(img_name).stem\n",
    "    label_path = os.path.join(labels_dir, base + \".txt\")\n",
    "    labels = []\n",
    "    if os.path.exists(label_path):\n",
    "        with open(label_path) as f:\n",
    "            for line in f:\n",
    "                cls = line.strip().split()[0]\n",
    "                labels.append(cls)\n",
    "                all_classes.add(cls)\n",
    "    image_labels.append(labels)\n",
    "\n",
    "all_classes = sorted(list(all_classes))\n",
    "class_to_idx = {c: i for i, c in enumerate(all_classes)}\n",
    "\n",
    "# Multi-label matrix\n",
    "Y = np.zeros((len(image_files), len(all_classes)), dtype=int)\n",
    "for i, labels in enumerate(image_labels):\n",
    "    for cls in labels:\n",
    "        Y[i, class_to_idx[cls]] = 1\n",
    "\n",
    "X = np.array(image_files).reshape(-1, 1)\n",
    "\n",
    "# ---------------------------\n",
    "# SPLIT: train vs temp (val+test)\n",
    "# ---------------------------\n",
    "train_size = train_frac\n",
    "temp_size = 1 - train_size\n",
    "\n",
    "X_train, Y_train, X_temp, Y_temp = iterative_train_test_split(X, Y, test_size=temp_size)\n",
    "\n",
    "# Split temp into val/test\n",
    "val_ratio = val_frac / (val_frac + test_frac)  # fraction of temp for val\n",
    "X_val, Y_val, X_test, Y_test = iterative_train_test_split(X_temp, Y_temp, test_size=1 - val_ratio)\n",
    "\n",
    "# ---------------------------\n",
    "# COPY FILES TO SPLITS\n",
    "# ---------------------------\n",
    "def copy_split_files(X_split, split_dir):\n",
    "    for img_name in X_split.flatten():\n",
    "        base = Path(img_name).stem\n",
    "        src_img = os.path.join(images_dir, img_name)\n",
    "        src_lbl = os.path.join(labels_dir, base + \".txt\")\n",
    "        dst_img = os.path.join(split_dir, \"images\", img_name)\n",
    "        dst_lbl = os.path.join(split_dir, \"labels\", base + \".txt\")\n",
    "        shutil.copy2(src_img, dst_img)\n",
    "        if os.path.exists(src_lbl):\n",
    "            shutil.copy2(src_lbl, dst_lbl)\n",
    "\n",
    "copy_split_files(X_train, train_dir)\n",
    "copy_split_files(X_val, val_dir)\n",
    "copy_split_files(X_test, test_dir)\n",
    "\n",
    "# ---------------------------\n",
    "# PRINT CLASS COUNTS PER SPLIT\n",
    "# ---------------------------\n",
    "def print_class_counts(split_dir, split_name):\n",
    "    counts = Counter()\n",
    "    for fname in os.listdir(os.path.join(split_dir, \"labels\")):\n",
    "        path = os.path.join(split_dir, \"labels\", fname)\n",
    "        with open(path) as f:\n",
    "            for line in f:\n",
    "                cls = line.strip().split()[0]\n",
    "                counts[cls] += 1\n",
    "    total_instances = sum(counts.values())\n",
    "    total_images = len(os.listdir(os.path.join(split_dir, \"images\")))\n",
    "    print(f\"\\n{split_name} split: {total_images} images, {total_instances} instances\")\n",
    "    for cls in sorted(counts.keys()):\n",
    "        print(f\"  Class {cls}: {counts[cls]} instances\")\n",
    "    return counts\n",
    "\n",
    "train_counts = print_class_counts(train_dir, \"TRAIN\")\n",
    "val_counts   = print_class_counts(val_dir, \"VAL\")\n",
    "test_counts  = print_class_counts(test_dir, \"TEST\")"
   ]
