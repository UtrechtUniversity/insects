     "text": [
      "Done\n"
     ]
    }
   ],
   "source": [
    "\"\"\"\n",
    "Counts class IDs in YOLO label files and returns a list of class IDs\n",
    "that appear fewer than `min_instances` times.\n",
    "\n",
    "label_paths (str): Path to labels directory.\n",
    "min_instances (int): Minimum number of instances required to keep a class.\n",
    "\n",
    "Returns List[str]: Class IDs with fewer than `min_instances` occurrences.\n",
    "\"\"\"\n",
    "def get_underrepresented_classes(label_paths, min_instances=95):\n",
    "\n",
    "    class_counts = Counter()\n",
    "\n",
    "    # Count each class ID from all label files\n",
    "    for filename in os.listdir(label_paths):\n",
    "        if not filename.endswith(\".txt\"):\n",
    "            continue\n",
    "\n",
    "        file_path = os.path.join(label_paths, filename)\n",
    "\n",
    "        with open(file_path, \"r\") as f:\n",
    "            for line in f:\n",
    "                parts = line.strip().split()\n",
    "                if parts:\n",
    "                    class_id = parts[0]\n",
    "                    class_counts[class_id] += 1\n",
    "\n",
    "    # Collect class IDs with counts below the threshold\n",
    "    underrepresented = [cls_id for cls_id, count in class_counts.items() if count < min_instances]\n",
    "\n",
    "    return underrepresented\n",
    "\n",
    "print(\"Done\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "fbffdc21-5a26-448b-9117-0bc1e88404c9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Done\n"
     ]
    }
   ],
   "source": [
    "for class_id in get_underrepresented_classes(labels_path):\n",
    "    remove_class_from_labels_and_paint(class_id, images_path, labels_path)\n",
    "\n",
    "print(\"Done\")"
   ]
  },
