   "source": [
    "distance_mode = \"relative\"\n",
    "DISTANCE_THRESHOLD_PIXELS = 150         # used if distance_mode == \"pixels\"\n",
    "DISTANCE_THRESHOLD_REL = 0.05          # fraction of image diagonal, used if \"relative\"\n",
    "\n",
    "# Margin to add around cluster bounding box (fraction of crop width/height)\n",
    "MARGIN = 0.15   # 15% margin\n",
    "\n",
    "# Minimum fraction of box area that must remain inside a crop to keep that box in that crop\n",
    "MIN_VISIBLE_FRACTION = 0.25\n",
    "\n",
    "# Optional: whether to save cluster containing a single object (Debugging)\n",
    "SAVE_SINGLETONS = True\n",
    "\n",
    "\"\"\"\n",
    "Pad the given crop (H x W x C) to a square by adding border with bg_color.\n",
    "Returns padded_image, pad_left, pad_top\n",
    "\"\"\"\n",
    "def pad_crop_to_square(crop, bg_color):\n",
    "    h, w = crop.shape[:2]\n",
    "    if h == w:\n",
    "        return crop, 0, 0  # already square\n",
    "    size = max(h, w)\n",
    "    pad_vert = size - h\n",
    "    pad_h_top = pad_vert // 2\n",
    "    pad_h_bottom = pad_vert - pad_h_top\n",
    "    pad_h = (pad_h_top, pad_h_bottom)\n",
    "\n",
    "    pad_horz = size - w\n",
    "    pad_w_left = pad_horz // 2\n",
    "    pad_w_right = pad_horz - pad_w_left\n",
    "    pad_w = (pad_w_left, pad_w_right)\n",
    "\n",
    "    padded = cv2.copyMakeBorder(crop,\n",
    "                                pad_h[0], pad_h[1],\n",
    "                                pad_w[0], pad_w[1],\n",
    "                                borderType=cv2.BORDER_CONSTANT,\n",
    "                                value=bg_color)\n",
    "    return padded, pad_w_left, pad_h_top\n",
    "\n",
    "# Step 3: Simple greedy clustering based on center-to-center distance.\n",
    "\"\"\"\n",
    "centers: list of (x, y) tuples\n",
    "threshold: pixel distance threshold\n",
    "Returns list of clusters (each cluster is list of indices into centers)\n",
    "\"\"\"\n",
    "def cluster_centers_greedy(centers, threshold): \n",
    "    clusters = []\n",
    "    used = set()\n",
    "    n = len(centers)\n",
    "    for i in range(n):\n",
    "        if i in used:\n",
    "            continue\n",
    "        # start a new cluster with i\n",
    "        cluster = [i]\n",
    "        used.add(i)\n",
    "        # scan others and add those within threshold to this cluster (single-pass)\n",
    "        # this is greedy and transitive: newly added may pull in others due to distance\n",
    "        j = 0\n",
    "        while j < len(cluster):\n",
    "            idx = cluster[j]\n",
    "            cx, cy = centers[idx]\n",
    "            for k in range(n):\n",
    "                if k in used:\n",
    "                    continue\n",
    "                kx, ky = centers[k]\n",
    "                dist = math.hypot(cx - kx, cy - ky)\n",
    "                if dist <= threshold:\n",
    "                    cluster.append(k)\n",
    "                    used.add(k)\n",
    "            j += 1\n",
    "        clusters.append(cluster)\n",
    "    return clusters\n",
    "\n",
    "\n",
    "\"\"\"\n",
    "Process single image and label to make crops per cluster and create files.\n",
    "Returns number of crops saved for this image.\n",
    "\"\"\"\n",
    "def crop_clusters_from_image(image_path, label_path, out_images_dir, out_labels_dir,\n",
    "                             distance_mode=\"relative\", dist_px=150, dist_rel=0.05,\n",
    "                             margin_frac=0.15, min_visible=0.25, save_singletons=True):\n",
    "\n",
    "    img = cv2.imread(image_path)\n",
    "    if img is None:\n",
    "        print(f\"Unable to load image: {image_path}\")\n",
    "        return 0\n",
    "    img_h, img_w = img.shape[:2]\n",
    "\n",
    "    # Step 1: read YOLO labels and convert to pixel boxes & centers\n",
    "    boxes = []          # (class_id, x1, y1, x2, y2)\n",
    "    centers = []        # (cx, cy)\n",
    "    with open(label_path, \"r\") as f:\n",
    "        for line in f:\n",
    "            parts = line.strip().split()\n",
    "            if len(parts) < 5:\n",
    "                continue\n",
    "            cls = parts[0]\n",
    "            xc, yc, bw, bh = map(float, parts[1:5])\n",
    "            x1, y1, x2, y2 = yolo_to_pixels(xc, yc, bw, bh, img_w, img_h)\n",
    "            # clamp small negatives\n",
    "            x1, y1, x2, y2 = max(0, x1), max(0, y1), min(img_w, x2), min(img_h, y2)\n",
    "            boxes.append((cls, x1, y1, x2, y2))\n",
    "            cx = (x1 + x2) / 2.0\n",
    "            cy = (y1 + y2) / 2.0\n",
    "            centers.append((cx, cy))\n",
    "\n",
    "    if not boxes:\n",
    "        return 0\n",
    "\n",
    "    # Step 2: choose distance threshold in pixels\n",
    "    if distance_mode == \"pixels\":\n",
    "        threshold = dist_px\n",
    "    else:\n",
    "        # relative to diagonal length\n",
    "        diag = math.hypot(img_w, img_h)\n",
    "        threshold = diag * dist_rel\n",
    "\n",
    "    # Step 3: cluster the centers\n",
    "    clusters = cluster_centers_greedy(centers, threshold)\n",
    "\n",
    "    # Step 4 & 5: calculate crop rects and adjust labels\n",
    "    crops_saved = 0\n",
    "    base_name = Path(image_path).stem\n",
    "    for ci, cluster in enumerate(clusters):\n",
    "        if (len(cluster) == 1) and (not save_singletons):\n",
    "            continue\n",
    "\n",
    "        # calculate union bbox of all boxes in this cluster\n",
    "        xs1 = [boxes[i][1] for i in cluster]\n",
    "        ys1 = [boxes[i][2] for i in cluster]\n",
    "        xs2 = [boxes[i][3] for i in cluster]\n",
    "        ys2 = [boxes[i][4] for i in cluster]\n",
    "\n",
    "        crop_x1 = min(xs1)\n",
    "        crop_y1 = min(ys1)\n",
    "        crop_x2 = max(xs2)\n",
    "        crop_y2 = max(ys2)\n",
    "\n",
    "        # original crop width/height (before making square)\n",
    "        crop_w = crop_x2 - crop_x1\n",
    "        crop_h = crop_y2 - crop_y1\n",
    "        pad_w = crop_w * margin_frac\n",
    "        pad_h = crop_h * margin_frac\n",
    "\n",
    "        crop_x1 = clamp(int(crop_x1 - pad_w), 0, img_w - 1)\n",
    "        crop_y1 = clamp(int(crop_y1 - pad_h), 0, img_h - 1)\n",
    "        crop_x2 = clamp(int(crop_x2 + pad_w), 0, img_w)\n",
    "        crop_y2 = clamp(int(crop_y2 + pad_h), 0, img_h)\n",
    "\n",
    "        # ensure valid\n",
    "        if crop_x2 <= crop_x1 or crop_y2 <= crop_y1:\n",
    "            continue\n",
    "\n",
    "        # extract crop (original)\n",
    "        crop = img[crop_y1:crop_y2, crop_x1:crop_x2]\n",
    "        crop_h2, crop_w2 = crop.shape[:2]\n",
    "\n",
    "        # make the crop square by padding with estimated background color\n",
    "        # Step A: estimate background color from area around the would-be crop\n",
    "        try:\n",
    "            import numpy as np\n",
    "        except Exception:\n",
    "            raise\n",
    "\n",
    "        bg_color = get_background_color(img, crop_x1, crop_y1, crop_x2, crop_y2, sample_border=5)\n",
    "\n",
    "        # Step B: pad crop to square and get pad offsets (in pixels)\n",
    "        padded_crop, pad_left, pad_top = pad_crop_to_square(crop, bg_color)\n",
    "        padded_h, padded_w = padded_crop.shape[:2]  # will be square: padded_h == padded_w\n",
    "\n",
    "        # Build new label lines for objects that are sufficiently visible in this padded crop\n",
    "        new_label_lines = []\n",
    "        for idx in cluster:\n",
    "            cls, bx1, by1, bx2, by2 = boxes[idx]\n",
    "\n",
    "            # compute intersection with original (unpadded) crop (same as before)\n",
    "            inter_x1 = max(bx1, crop_x1)\n",
    "            inter_y1 = max(by1, crop_y1)\n",
    "            inter_x2 = min(bx2, crop_x2)\n",
    "            inter_y2 = min(by2, crop_y2)\n",
    "\n",
    "            inter_area = box_area(inter_x1, inter_y1, inter_x2, inter_y2)\n",
    "            orig_area = box_area(bx1, by1, bx2, by2)\n",
    "            visible_frac = 0.0 if orig_area <= 0 else (inter_area / orig_area)\n",
    "\n",
    "            # keep box only if enough visible (avoid extremely truncated boxes)\n",
    "            if visible_frac < min_visible:\n",
    "                continue\n",
    "\n",
    "            # convert intersection box (clipped to original crop) to crop-local coordinates\n",
    "            clipped_x1 = max(bx1, crop_x1) - crop_x1\n",
    "            clipped_y1 = max(by1, crop_y1) - crop_y1\n",
    "            clipped_x2 = min(bx2, crop_x2) - crop_x1\n",
    "            clipped_y2 = min(by2, crop_y2) - crop_y1\n",
    "\n",
    "            # Now account for padding: shift by pad_left, pad_top\n",
    "            padded_x1 = clipped_x1 + pad_left\n",
    "            padded_y1 = clipped_y1 + pad_top\n",
    "            padded_x2 = clipped_x2 + pad_left\n",
    "            padded_y2 = clipped_y2 + pad_top\n",
    "\n",
    "            # convert to YOLO normalized relative to the padded (square) crop\n",
    "            nx, ny, nw, nh = pixels_to_yolo(padded_x1, padded_y1, padded_x2, padded_y2, padded_w, padded_h)\n",
    "\n",
    "            # clamp to [0,1]\n",
    "            nx = min(max(nx, 0.0), 1.0)\n",
    "            ny = min(max(ny, 0.0), 1.0)\n",
    "            nw = min(max(nw, 0.0), 1.0)\n",
    "            nh = min(max(nh, 0.0), 1.0)\n",
    "\n",
    "            new_label_lines.append(f\"{cls} {nx:.6f} {ny:.6f} {nw:.6f} {nh:.6f}\\n\")\n",
    "\n",
    "        # skip if no valid boxes retained\n",
    "        if not new_label_lines:\n",
    "            continue\n",
    "\n",
    "        # Step 6: Save crop image and label (padded square)\n",
    "        out_img_name = f\"{base_name}_crop{ci}.jpg\"\n",
    "        out_label_name = f\"{base_name}_crop{ci}.txt\"\n",
    "\n",
    "        cv2.imwrite(os.path.join(out_images_dir, out_img_name), padded_crop)\n",
    "        with open(os.path.join(out_labels_dir, out_label_name), \"w\") as lf:\n",
    "            lf.writelines(new_label_lines)\n",
    "\n",
    "        crops_saved += 1\n",
    "\n",
    "    return crops_saved\n",
    "\n",
    "\n",
    "def process_all_images(images_dir, labels_dir, out_images_dir, out_labels_dir,\n",
    "                       distance_mode=\"relative\", dist_px=150, dist_rel=0.05,\n",
    "                       margin_frac=0.15, min_visible=0.25, save_singletons=True):\n",
    "    total = 0\n",
    "    image_files = [f for f in os.listdir(images_dir) if f.lower().endswith((\".jpg\", \".png\", \".jpeg\"))]\n",
    "    for img_name in sorted(image_files):\n",
    "        img_path = os.path.join(images_dir, img_name)\n",
    "        label_path = os.path.join(labels_dir, Path(img_name).stem + \".txt\")\n",
    "        if not os.path.exists(label_path):\n",
    "            # skip images without labels\n",
    "            continue\n",
    "        saved = crop_clusters_from_image(\n",
    "            img_path, label_path, out_images_dir, out_labels_dir,\n",
    "            distance_mode=distance_mode, dist_px=dist_px, dist_rel=dist_rel,\n",
    "            margin_frac=margin_frac, min_visible=min_visible, save_singletons=save_singletons\n",
    "        )\n",
    "        if saved:\n",
    "            print(f\"Saved {saved} crops for {img_name}\")\n",
    "        total += saved\n",
    "    print(f\"Total crops saved: {total}\")\n",
    "\n",
    "\n",
    "process_all_images(\n",
    "        images_path, labels_path, crop_images_path, crop_labels_path,\n",
    "        distance_mode=distance_mode, dist_px=DISTANCE_THRESHOLD_PIXELS, dist_rel=DISTANCE_THRESHOLD_REL,\n",
    "        margin_frac=MARGIN, min_visible=MIN_VISIBLE_FRACTION, save_singletons=SAVE_SINGLETONS\n",
    "    )"
   ]
  },
